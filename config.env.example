# Redis 连接配置（支持多个 Redis 实例）
# 格式：REDIS_<编号>_<配置项>
# 编号从 1 开始，例如：REDIS_1_ADDR, REDIS_2_ADDR

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ===== 将靓号上传到此地址, 如果有配置的话 =====
POST_URL=

# ===== 靓号缓存配置 =====
CACHE_ENABLED=true
# AES-256 密钥（64 位十六进制 = 32 字节）
# 生产环境请使用: openssl rand -hex 32
CACHE_AES_KEY=8471cbaa7ba6f001cb8c30fb0f13244b14485ecde73c232568cc563e2dda8a93
CACHE_DB_PATH=./address_cache.db
CACHE_MAX_6A=1000
CACHE_MAX_7A=1000